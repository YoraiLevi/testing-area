[0.011731893,"o","\u001b[H\u001b[2J\u001b[3J"]
[0.011914013,"o","This is the Z Shell configuration function for new users,\r\nzsh-newuser-install.\r\nYou are seeing this message because you have no zsh startup files\r\n(the files .zshenv, .zprofile, .zshrc, .zlogin in the directory\r\n~).  This function can help you with a few settings that should\r\nmake your use of the shell easier.\r\n\r\nYou can:\r\n\r\n(q)  Quit and do nothing.  The function will be run again next time.\r\n"]
[0.011952956,"o","\r\n(0)  Exit, creating the file ~/.zshrc containing just a comment.\r\n     That will prevent this function being run again.\r\n\r\n(1)  Continue to the main menu.\r\n\r\n"]
[0.012005313,"o","(2)  Populate your ~/.zshrc with the configuration recommended\r\n     by the system administrator and exit (you will need to edit\r\n     the file by hand, if so desired).\r\n\r\n--- Type one of the keys in parentheses --- "]
[0.951537136,"o","e"]
[0.951567653,"o","\r\n"]
[0.951636762,"o","Aborting.\r\n"]
[0.951684083,"o","The function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
[0.965629879,"o","zsh compinit: insecure directories, run compaudit for list.\r\nIgnore insecure directories and continue [y] or abort compinit [n]? "]
