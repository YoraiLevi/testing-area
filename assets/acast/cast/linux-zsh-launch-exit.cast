[0.019863073,"o","\u001b[H\u001b[2J\u001b[3J"]
[0.020007831,"o","This is the Z Shell configuration function for new users,\r\nzsh-newuser-install.\r\nYou are seeing this message because you have no zsh startup files\r\n(the files .zshenv, .zprofile, .zshrc, .zlogin in the directory\r\n~).  This function can help you with a few settings that should\r\nmake your use of the shell easier.\r\n\r\nYou can:\r\n\r\n(q)  Quit and do nothing.  The function will be run again next time.\r\n"]
[0.020029311,"o","\r\n(0)  Exit, creating the file ~/.zshrc containing just a comment.\r\n"]
[0.020040191,"o","     That will prevent this function being run again.\r\n\r\n(1)  Continue to the main menu.\r\n\r\n"]
[0.020053406,"o","(2)  Populate your ~/.zshrc with the configuration recommended\r\n     by the system administrator and exit (you will need to edit\r\n     the file by hand, if so desired).\r\n\r\n"]
[0.020089223,"o","--- Type one of the keys in parentheses --- "]
[0.951164488,"o","o"]
[0.95125084,"o","\r\n"]
[0.951276367,"o","Aborting.\r\n"]
[0.951315089,"o","The function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
