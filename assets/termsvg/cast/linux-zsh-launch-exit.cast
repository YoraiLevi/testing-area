[1.622544,"o","\r\n"]
[1.622628,"o","Aborting.\r\nThe function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
[1.637957,"o","zsh compinit: insecure directories, run compaudit for list.\r\nIgnore insecure directories and continue [y] or abort compinit [n]? "]
