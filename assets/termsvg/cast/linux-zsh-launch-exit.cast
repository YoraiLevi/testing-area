[1.620599,"o","\r\n"]
[1.620613,"o","Aborting.\r\n"]
[1.620624,"o","The function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
[1.626881,"o","zsh compinit: insecure directories, run compaudit for list.\r\nIgnore insecure directories and continue [y] or abort compinit [n]? "]
