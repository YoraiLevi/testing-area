[1.621012,"o","\r\n"]
[1.621057,"o","Aborting.\r\n"]
[1.621064,"o","The function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
[1.632989,"o","zsh compinit: insecure directories, run compaudit for list.\r\nIgnore insecure directories and continue [y] or abort compinit [n]? "]
