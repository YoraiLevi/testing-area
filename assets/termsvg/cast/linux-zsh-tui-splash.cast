[0.011791,"o","\u001b[H\u001b[2J\u001b[3J"]
[0.011976,"o","This is the Z Shell configuration function for new users,\r\nzsh-newuser-install.\r\nYou are seeing this message because you have no zsh startup files\r\n(the files .zshenv, .zprofile, .zshrc, .zlogin in the directory\r\n~).  This function can help you with a few settings that should\r\nmake your use of the shell easier.\r\n\r\nYou can:\r\n\r\n(q)  Quit and do nothing.  The function will be run again next time.\r\n"]
[0.011997,"o","\r\n(0)  Exit, creating the file ~/.zshrc containing just a comment.\r\n     That will prevent this function being run again.\r\n\r\n(1)  Continue to the main menu.\r\n\r\n"]
[0.012057,"o","(2)  Populate your ~/.zshrc with the configuration recommended\r\n     by the system administrator and exit (you will need to edit\r\n     the file by hand, if so desired).\r\n\r\n--- Type one of the keys in parentheses --- "]
[1.61687,"o","s"]
[1.616952,"o","\r\n"]
[1.616982,"o","Aborting.\r\n"]
[1.617009,"o","The function will be run again next time.  To prevent this, execute:\r\n  touch ~/.zshrc\r\n"]
[1.63118,"o","zsh compinit: insecure directories, run compaudit for list.\r\nIgnore insecure directories and continue [y] or abort compinit [n]? "]
[1.681653,"o","hcompinit: initialization aborted\r\n"]
